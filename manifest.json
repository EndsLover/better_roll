{
  "manifest_version": 3,
  "name": "Better Roll",
  "version": "1.0.0",
  "description": "Filter Crunchyroll's Release Calendar by audio language, tidy its layout and optionally show romaji titles. Unofficial.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.crunchyroll.com/*",
    "https://graphql.anilist.co/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.crunchyroll.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "better-roll@endslover.github.io"
    }
  }
}
